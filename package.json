{
  "name": "janun-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/prepare-browser-assets.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && vitest run",
    "prepare:assets": "node scripts/prepare-browser-assets.mjs",
    "build:hosted": "npm run build && node scripts/build-worker.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "pdfjs-dist": "^6.2.108",
    "tesseract.js": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "undici": "^8.12.2"
  }
}
