# true: static research preview. false: full Next.js + FastAPI application.
NEXT_PUBLIC_DEMO_MODE=true
# Server-side only; used when NEXT_PUBLIC_DEMO_MODE=false.
BACKEND_URL=http://127.0.0.1:8000

# Docker Compose and backend (do not commit real secrets)
POSTGRES_PASSWORD=replace-with-a-long-random-password
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
OPENAI_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# Optional explicit server speech; provider-compatible model/voice IDs are required.
SPEECH_TRANSCRIPTION_MODEL=
SPEECH_SYNTHESIS_MODEL=
SPEECH_VOICE_EN=
SPEECH_VOICE_BN=

# Optional public HTTPS API root for a separately deployed backend, including /api.
# When set at BUILD TIME, the frontend uses live APIs and does not silently use demo data.
NEXT_PUBLIC_API_BASE_URL=
